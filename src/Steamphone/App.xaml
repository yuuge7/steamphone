<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Steamphone"
             xmlns:vm="clr-namespace:Steamphone.ViewModels" x:Class="Steamphone.App">
  <Application.Resources>
    <ResourceDictionary>
      <local:InverseBoolConverter x:Key="Not" />
      <Color x:Key="Navy">#101720</Color>
      <Color x:Key="SteamBlue">#73C7E8</Color>
      <!-- Shared rhythm: 24dp page gutter, 16dp sections, 12dp controls, 48dp touch targets. -->
      <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F3F6F8, Dark=#101720}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
      </Style>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#162637, Dark=#EFF4F8}" />
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="15" />
      </Style>
      <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontFamily" Value="Display" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="LineHeight" Value="1.05" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
      </Style>
      <Style x:Key="Subtitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#536779, Dark=#A1B2C2}" />
        <Setter Property="LineHeight" Value="1.2" />
      </Style>
      <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Subtitle}">
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="1.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#3D6F86, Dark=#8CB2C6}" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
      </Style>
      <Style x:Key="Data" TargetType="Label">
        <Setter Property="FontFamily" Value="Mono" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#536779, Dark=#96A8B9}" />
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#18232F}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#D9E2E9, Dark=#2B3B4B}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="20" />
      </Style>
      <Style x:Key="StatusBadge" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="10,7" />
      </Style>
      <Style x:Key="SegmentedControl" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E9EFF3, Dark=#14202C}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="4" />
      </Style>
      <Style x:Key="Input" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
      </Style>
      <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light=#DBE4EA, Dark=#2A3947}" />
        <Setter Property="HeightRequest" Value="1" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#166D91, Dark=#73C7E8}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#102532}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="50" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="VisualStateManager.VisualStateGroups">
          <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.4" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Focused"><VisualState.Setters><Setter Property="BorderWidth" Value="2" /><Setter Property="BorderColor" Value="{AppThemeBinding Light=#162637, Dark=White}" /></VisualState.Setters></VisualState>
          </VisualStateGroup></VisualStateGroupList>
        </Setter>
      </Style>
      <Style x:Key="Secondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E7EEF3, Dark=#223140}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#225D77, Dark=#CCE0ED}" />
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinimumHeightRequest" Value="50" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,12" />
      </Style>
      <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Secondary}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#166D91, Dark=#73C7E8}" />
      </Style>
      <Style x:Key="Filter" TargetType="Button" BasedOn="{StaticResource Quiet}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#536779, Dark=#96A8B9}" />
      </Style>
      <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#162637, Dark=#EFF4F8}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#64798A, Dark=#879BAC}" />
        <Setter Property="MinimumHeightRequest" Value="52" />
      </Style>
      <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#162637, Dark=#EFF4F8}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light=#536779, Dark=#A1B2C2}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
      </Style>
      <Style TargetType="SearchBar">
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="CancelButtonColor" Value="{AppThemeBinding Light=#166D91, Dark=#73C7E8}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#162637, Dark=#EFF4F8}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#64798A, Dark=#879BAC}" />
        <Setter Property="MinimumHeightRequest" Value="52" />
      </Style>
      <Style TargetType="Switch"><Setter Property="OnColor" Value="{AppThemeBinding Light=#166D91, Dark=#73C7E8}" /></Style>
      <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#162637, Dark=#EFF4F8}" />
        <Setter Property="FontFamily" Value="BarlowSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="48" />
      </Style>
      <Style x:Key="Error" TargetType="Label" x:DataType="vm:BaseViewModel">
        <Setter Property="Text" Value="{Binding Error}" />
        <Setter Property="IsVisible" Value="{Binding HasError}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#AD3044, Dark=#FFA6AE}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="SemanticProperties.Description" Value="{Binding Error}" />
      </Style>
      <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light=#166D91, Dark=#73C7E8}" />
        <Setter Property="HeightRequest" Value="28" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
