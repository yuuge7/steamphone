<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Version.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Steamphone</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Steamphone</ApplicationTitle>
    <ApplicationId>com.steamphone.app</ApplicationId>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- SteamKit2 3.x and sqlite-net use reflection. Do not trim their model metadata. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <!-- .NET Android's generated JNI lookup can break Release startup after an incremental build.
         Use runtime registration until dotnet/maui#34476 is resolved. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)/Microsoft/jdk-21/bin/javac.exe')">$(LOCALAPPDATA)/Microsoft/jdk-21</JavaSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../Steamphone.Core/Steamphone.Core.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#101720" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#101720" BaseSize="128,128" />
    <MauiImage Include="Resources/Images/*" />
    <MauiFont Include="Resources/Fonts/*.ttf" />
    <MauiAsset Include="Resources/Fonts/Licenses/*.txt" LogicalName="font-licenses/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
