<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="Steamphone.AppShell"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light=#F3F6F8, Dark=#101720}"
       Shell.ForegroundColor="{AppThemeBinding Light=#162637, Dark=#EFF4F8}"
       Shell.TitleColor="{AppThemeBinding Light=#162637, Dark=#EFF4F8}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light=White, Dark=#141D27}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light=#166D91, Dark=#73C7E8}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light=#64798A, Dark=#879BAC}">
  <TabBar>
    <ShellContent x:Name="HomeTab" Title="Acasă" Route="home" Icon="home.png" />
    <ShellContent x:Name="FriendsTab" Title="Prieteni" Route="friends" Icon="friends.png" />
    <ShellContent x:Name="MappingsTab" Title="Mapări" Route="mappings" Icon="mappings.png" />
    <ShellContent x:Name="StatsTab" Title="Statistici" Route="stats" Icon="stats.png" />
    <ShellContent x:Name="SettingsTab" Title="Setări" Route="settings" Icon="settings.png" />
  </TabBar>
</Shell>
