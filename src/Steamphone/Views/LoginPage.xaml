<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Steamphone.ViewModels"
             x:Class="Steamphone.Views.LoginPage" x:DataType="vm:LoginViewModel" NavigationPage.HasNavigationBar="False" Title="Conectare">
  <ScrollView>
    <VerticalStackLayout Padding="24,24,24,28" Spacing="22" MaximumWidthRequest="540" HorizontalOptions="Fill">
      <HorizontalStackLayout Spacing="10"><Image Source="brand_mark.png" WidthRequest="28" HeightRequest="28" /><Label Text="STEAMPHONE" FontFamily="Display" FontSize="23" CharacterSpacing="2" VerticalOptions="Center" /></HorizontalStackLayout>
      <VerticalStackLayout Spacing="12" Margin="0,12,0,0">
        <Label Text="Conectează-te la Steam" Style="{StaticResource Title}" FontSize="34" />
        <Label Text="Prietenii și activitatea ta de joc,&#10;direct de pe telefon." Style="{StaticResource Subtitle}" />
      </VerticalStackLayout>
      <Border Style="{StaticResource Card}" Padding="20">
        <VerticalStackLayout Spacing="16">
          <Label Text="Contul tău Steam" Style="{StaticResource SectionTitle}" />
          <VerticalStackLayout Spacing="7">
            <Label Text="Nume de cont Steam" Style="{StaticResource Caption}" />
            <Border Style="{StaticResource Input}"><Entry Text="{Binding Username}" Placeholder="Numele contului" ReturnType="Next" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" SemanticProperties.Description="Nume de cont Steam" /></Border>
          </VerticalStackLayout>
          <VerticalStackLayout Spacing="7">
            <Label Text="Parolă" Style="{StaticResource Caption}" />
            <Border Style="{StaticResource Input}"><Entry Text="{Binding Password}" Placeholder="Parola Steam" IsPassword="True" ReturnType="Go" ReturnCommand="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" SemanticProperties.Description="Parola Steam" /></Border>
          </VerticalStackLayout>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Folosește codul Steam Guard" Style="{StaticResource Caption}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding PreferGuardCode}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" SemanticProperties.Description="Folosește codul Steam Guard în loc de aprobare pe telefon" /></Grid>
          <Label Style="{StaticResource Error}" />
          <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
          <Button Text="Conectează-te" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
          <Button Text="Continuă sesiunea salvată" Command="{Binding ResumeCommand}" Style="{StaticResource Secondary}" IsVisible="{Binding HasSavedAccount}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
          <Button Text="Anulează conectarea" Command="{Binding CancelCommand}" Style="{StaticResource Quiet}" IsVisible="{Binding IsBusy}" />
          <Label Text="{Binding ConnectionMessage}" Style="{StaticResource Caption}" FontSize="11" />
        </VerticalStackLayout>
      </Border>
      <Border Style="{StaticResource Card}" IsVisible="{Binding HasGuardChallenge}" Stroke="{AppThemeBinding Light=#166D91, Dark=#73C7E8}">
        <VerticalStackLayout Spacing="12">
          <Label Text="Steam Guard" Style="{StaticResource SectionTitle}" />
          <Label Text="{Binding GuardMessage}" Style="{StaticResource Subtitle}" />
          <Border Style="{StaticResource Input}" IsVisible="{Binding NeedsCode}"><Entry Text="{Binding GuardCode}" Placeholder="Cod Steam Guard" FontFamily="Mono" MaxLength="10" ReturnType="Go" ReturnCommand="{Binding SubmitGuardCommand}" SemanticProperties.Description="Cod Steam Guard" /></Border>
          <Button Text="Verifică codul" Command="{Binding SubmitGuardCommand}" IsVisible="{Binding NeedsCode}" />
        </VerticalStackLayout>
      </Border>
      <Button Text="Configurează aplicațiile mai întâi" Command="{Binding ConfigureCommand}" Style="{StaticResource Secondary}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
      <VerticalStackLayout Spacing="8">
        <BoxView Style="{StaticResource Divider}" />
        <Label Text="Parola nu se salvează. Sesiunea este protejată pe dispozitiv cu Android Keystore." Style="{StaticResource Caption}" FontSize="11" />
        <Label Text="Proiect independent. Fără afiliere cu Valve." Style="{StaticResource Caption}" FontSize="11" />
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
