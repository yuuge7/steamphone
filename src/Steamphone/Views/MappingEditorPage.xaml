<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Steamphone.ViewModels"
             xmlns:services="clr-namespace:Steamphone.Services"
             x:Class="Steamphone.Views.MappingEditorPage" x:DataType="vm:MappingEditorViewModel" Title="Asociază o aplicație" Shell.TabBarIsVisible="False" Shell.NavBarIsVisible="True">
  <Grid Padding="24,12,24,20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" MaximumWidthRequest="720" HorizontalOptions="Fill">
    <Border Style="{StaticResource Card}" Padding="16">
      <VerticalStackLayout Spacing="8">
        <Label Text="{Binding SelectedLabel}" FontFamily="BarlowSemiBold" FontSize="17" MaxLines="1" LineBreakMode="TailTruncation" />
        <Border Style="{StaticResource Input}"><Entry Text="{Binding SteamAppId}" Keyboard="Numeric" Placeholder="Steam AppID · de exemplu 570" MaxLength="10" SemanticProperties.Description="Steam AppID" /></Border>
        <Grid ColumnDefinitions="*,Auto"><Label Text="Asociere activă" VerticalOptions="Center" FontSize="14" /><Switch Grid.Column="1" IsToggled="{Binding Enabled}" SemanticProperties.Description="Activează maparea" /></Grid>
      </VerticalStackLayout>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Input}" Padding="0"><SearchBar Text="{Binding SearchText}" Placeholder="Caută o aplicație instalată" SemanticProperties.Description="Caută aplicații" /></Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><Label Text="Include aplicații de sistem" Style="{StaticResource Caption}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ShowSystemApps}" SemanticProperties.Description="Include aplicațiile de sistem" /></Grid>
    <CollectionView Grid.Row="3" ItemsSource="{Binding Apps}" SelectionMode="Single" SelectedItem="{Binding SelectedApp, Mode=TwoWay}">
      <CollectionView.EmptyView><Label Text="Nicio aplicație găsită. Schimbă căutarea sau include aplicațiile de sistem." Style="{StaticResource Subtitle}" Margin="0,24" /></CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="services:InstalledApp">
          <Grid Padding="12,14" ColumnDefinitions="42,*" ColumnSpacing="14" MinimumHeightRequest="74">
            <VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates"><VisualState Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="Transparent" /></VisualState.Setters></VisualState><VisualState Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DCEBF2, Dark=#253C4D}" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <Image Source="{Binding Icon}" WidthRequest="42" HeightRequest="42" Aspect="AspectFit" SemanticProperties.Description="Iconița aplicației" />
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"><Label Text="{Binding DisplayName}" FontFamily="BarlowSemiBold" LineBreakMode="TailTruncation" /><Label Text="{Binding PackageName}" Style="{StaticResource Caption}" FontSize="11" LineBreakMode="TailTruncation" /></VerticalStackLayout>
          </Grid>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
    <VerticalStackLayout Grid.Row="4" Spacing="8"><Label Style="{StaticResource Error}" /><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" /><Button Text="Salvează asocierea" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" /></VerticalStackLayout>
  </Grid>
</ContentPage>
