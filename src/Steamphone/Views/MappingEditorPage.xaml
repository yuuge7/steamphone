<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Steamphone.ViewModels"
             xmlns:services="clr-namespace:Steamphone.Services"
             x:Class="Steamphone.Views.MappingEditorPage" x:DataType="vm:MappingEditorViewModel" Title="Asociază o aplicație" Shell.TabBarIsVisible="False">
  <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" MaximumWidthRequest="680" HorizontalOptions="Fill">
    <Border Style="{StaticResource Card}" Padding="16">
      <VerticalStackLayout Spacing="5">
        <Label Text="{Binding SelectedLabel}" FontSize="19" FontAttributes="Bold" />
        <Entry Text="{Binding SteamAppId}" Keyboard="Numeric" Placeholder="Steam AppID, de exemplu 570" MaxLength="10" SemanticProperties.Description="Steam AppID" />
        <Grid ColumnDefinitions="*,Auto"><Label Text="Mapare activă" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding Enabled}" SemanticProperties.Description="Activează maparea" /></Grid>
      </VerticalStackLayout>
    </Border>
    <SearchBar Grid.Row="1" Text="{Binding SearchText}" Placeholder="Caută o aplicație instalată" SemanticProperties.Description="Caută aplicații" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><Label Text="Include aplicații de sistem" Style="{StaticResource Subtitle}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ShowSystemApps}" SemanticProperties.Description="Include aplicațiile de sistem" /></Grid>
    <CollectionView Grid.Row="3" ItemsSource="{Binding Apps}" SelectionMode="Single" SelectedItem="{Binding SelectedApp, Mode=TwoWay}">
      <CollectionView.EmptyView><Label Text="Nicio aplicație găsită. Modifică filtrul sau include aplicațiile de sistem." Style="{StaticResource Subtitle}" Margin="12,24" /></CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="services:InstalledApp">
          <Grid Padding="12" ColumnDefinitions="44,*" ColumnSpacing="14" MinimumHeightRequest="72">
            <VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates"><VisualState Name="Normal" /><VisualState Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D5EAF9, Dark=#2B4963}" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <Image Source="{Binding Icon}" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" SemanticProperties.Description="Iconița aplicației" />
            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="{Binding DisplayName}" FontAttributes="Bold" LineBreakMode="TailTruncation" /><Label Text="{Binding PackageName}" Style="{StaticResource Subtitle}" FontSize="11" LineBreakMode="TailTruncation" /></VerticalStackLayout>
          </Grid>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
    <VerticalStackLayout Grid.Row="4" Spacing="8"><Label Style="{StaticResource Error}" /><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" /><Button Text="Salvează maparea" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" /></VerticalStackLayout>
  </Grid>
</ContentPage>
