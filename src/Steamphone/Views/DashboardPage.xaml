<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Steamphone.ViewModels"
             xmlns:core="clr-namespace:Steamphone.Core;assembly=Steamphone.Core"
             x:Class="Steamphone.Views.DashboardPage" x:DataType="vm:DashboardViewModel" Title="Steamphone">
  <ScrollView>
    <VerticalStackLayout Padding="24,20,24,32" Spacing="20" MaximumWidthRequest="720" HorizontalOptions="Fill">
      <Grid ColumnDefinitions="*,48" ColumnSpacing="12">
        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
          <Image Source="brand_mark.png" HeightRequest="28" WidthRequest="28" VerticalOptions="Center" />
          <VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="STEAMPHONE" FontFamily="Display" FontSize="21" CharacterSpacing="1.5" /><Label Text="{Binding AccountName}" Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation" /></VerticalStackLayout>
        </Grid>
        <Button Grid.Column="1" ImageSource="settings.png" Style="{StaticResource Quiet}" Padding="12" Command="{Binding OpenSettingsCommand}" SemanticProperties.Description="Deschide setările" />
      </Grid>
      <VerticalStackLayout Spacing="6">
        <Label Text="Activitatea ta" Style="{StaticResource Title}" />
        <Label Text="Jocul și prezența ta pe Steam." Style="{StaticResource Subtitle}" />
      </VerticalStackLayout>

      <Border Stroke="#354B5C" StrokeShape="RoundRectangle 16" Padding="0" BackgroundColor="#192A38">
        <Grid ColumnDefinitions="3,*">
          <BoxView Color="#73C7E8" Margin="0,24,0,24">
            <BoxView.Triggers><DataTrigger TargetType="BoxView" Binding="{Binding IsRunning}" Value="True"><Setter Property="Color" Value="#B6DA7A" /></DataTrigger></BoxView.Triggers>
          </BoxView>
          <VerticalStackLayout Grid.Column="1" Spacing="14" Padding="21,20,20,20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <Label Text="ACUM PE TELEFON" FontFamily="BarlowSemiBold" TextColor="#92B3C6" CharacterSpacing="1.5" FontSize="10" VerticalOptions="Center" />
              <HorizontalStackLayout Grid.Column="1" Spacing="6">
                <Ellipse Fill="#879BAC" WidthRequest="6" HeightRequest="6" VerticalOptions="Center"><Ellipse.Triggers><DataTrigger TargetType="Ellipse" Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="#56CFB1" /></DataTrigger></Ellipse.Triggers></Ellipse>
                <Label Text="{Binding ConnectionLabel}" FontFamily="BarlowSemiBold" TextColor="#BBCBD7" FontSize="10" />
              </HorizontalStackLayout>
            </Grid>
            <Label Text="{Binding CurrentGame}" TextColor="#F2F7FA" FontFamily="Display" FontSize="28" LineBreakMode="WordWrap" />
            <Label Text="{Binding MonitorMessage}" TextColor="#A5B8C8" FontSize="13" />
            <BoxView Color="#354B5C" HeightRequest="1" />
            <VerticalStackLayout Spacing="6">
              <Label Text="{Binding ModeLabel}" TextColor="#92B3C6" FontFamily="BarlowSemiBold" FontSize="10" CharacterSpacing="1.5" />
              <Label Text="{Binding PresencePreview}" TextColor="#B8E5F4" FontFamily="BarlowMedium" FontSize="16" />
              <Label Text="{Binding ConnectionMessage}" TextColor="#A5B8C8" FontSize="12" />
            </VerticalStackLayout>
            <Button Text="Pornește monitorizarea" Command="{Binding StartCommand}" IsVisible="{Binding IsRunning, Converter={StaticResource Not}}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" BackgroundColor="#73C7E8" TextColor="#102532" />
            <Button Text="Oprește monitorizarea" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" BackgroundColor="#2D4557" TextColor="#E0EDF5" />
            <Button Text="Conectează contul Steam" Command="{Binding SignInCommand}" IsVisible="{Binding ShowSignIn}" BackgroundColor="Transparent" BorderColor="#456476" BorderWidth="1" TextColor="#B8E5F4" />
          </VerticalStackLayout>
        </Grid>
      </Border>
      <Border Style="{StaticResource Card}" IsVisible="{Binding UsageMissing}" Stroke="{AppThemeBinding Light=#AA792D, Dark=#BD9D62}">
        <VerticalStackLayout Spacing="10">
          <Label Text="Permite detectarea jocurilor" Style="{StaticResource SectionTitle}" />
          <Label Text="Activează accesul la utilizare pentru a recunoaște aplicația deschisă." Style="{StaticResource Subtitle}" />
          <Button Text="Deschide Setări" Command="{Binding OpenSettingsCommand}" Style="{StaticResource Secondary}" />
        </VerticalStackLayout>
      </Border>
      <Label Style="{StaticResource Error}" />
      <VerticalStackLayout Spacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Label Text="Vizibilitate" Style="{StaticResource SectionTitle}" />
          <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center"><Label Text="✓" TextColor="{AppThemeBinding Light=#3C765B, Dark=#79D4B3}" /><Label Text="Salvare automată" Style="{StaticResource Caption}" VerticalOptions="Center" /></HorizontalStackLayout>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="0" IsEnabled="{Binding PrivacySaving, Converter={StaticResource Not}}">
          <VerticalStackLayout Spacing="0" RadioButtonGroup.GroupName="Visibility" RadioButtonGroup.SelectedValue="{Binding SelectedVisibility}">
            <Grid Padding="10,2,16,12" RowDefinitions="48,Auto" BackgroundColor="Transparent">
              <Grid.Triggers><DataTrigger TargetType="Grid" Binding="{Binding SelectedVisibility}" Value="{x:Static core:VisibilityMode.Public}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EBF4F8, Dark=#213747}" /></DataTrigger></Grid.Triggers>
              <RadioButton Content="Joc vizibil" Value="{x:Static core:VisibilityMode.Public}" />
              <Label Grid.Row="1" Text="Prietenii văd ce joci." Style="{StaticResource Caption}" Margin="36,-2,0,0" />
            </Grid>
            <BoxView Style="{StaticResource Divider}" Margin="46,0,16,0" />
            <Grid Padding="10,2,16,12" RowDefinitions="48,Auto">
              <Grid.Triggers><DataTrigger TargetType="Grid" Binding="{Binding SelectedVisibility}" Value="{x:Static core:VisibilityMode.Invisible}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EBF4F8, Dark=#213747}" /></DataTrigger></Grid.Triggers>
              <RadioButton Content="Invizibil" Value="{x:Static core:VisibilityMode.Invisible}" />
              <Label Grid.Row="1" Text="Vezi prietenii. Apari offline." Style="{StaticResource Caption}" Margin="36,-2,0,0" />
            </Grid>
            <BoxView Style="{StaticResource Divider}" Margin="46,0,16,0" />
            <Grid Padding="10,2,16,12" RowDefinitions="48,Auto">
              <Grid.Triggers><DataTrigger TargetType="Grid" Binding="{Binding SelectedVisibility}" Value="{x:Static core:VisibilityMode.OnlineOnly}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EBF4F8, Dark=#213747}" /></DataTrigger></Grid.Triggers>
              <RadioButton Content="Doar online" Value="{x:Static core:VisibilityMode.OnlineOnly}" />
              <Label Grid.Row="1" Text="Ești online, cu jocul ascuns." Style="{StaticResource Caption}" Margin="36,-2,0,0" />
            </Grid>
            <BoxView Style="{StaticResource Divider}" Margin="46,0,16,0" />
            <Grid Padding="10,2,16,12" RowDefinitions="48,Auto">
              <Grid.Triggers><DataTrigger TargetType="Grid" Binding="{Binding SelectedVisibility}" Value="{x:Static core:VisibilityMode.LocalOnly}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EBF4F8, Dark=#213747}" /></DataTrigger></Grid.Triggers>
              <RadioButton Content="Doar local" Value="{x:Static core:VisibilityMode.LocalOnly}" />
              <Label Grid.Row="1" Text="Istoric pe telefon. Steam deconectat." Style="{StaticResource Caption}" Margin="36,-2,0,0" />
            </Grid>
          </VerticalStackLayout>
        </Border>
        <Label Text="{Binding PrivacyDetail}" Style="{StaticResource Caption}" />
        <ActivityIndicator IsVisible="{Binding PrivacySaving}" IsRunning="{Binding PrivacySaving}" />
        <Border Style="{StaticResource Input}" IsVisible="{Binding IsPublic}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="După închiderea jocului" Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Picker Grid.Column="1" Title="Status Steam" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" MinimumWidthRequest="110" SemanticProperties.Description="Status Steam după închiderea jocului" />
          </Grid>
        </Border>
        <Label Text="Modul se aplică prezenței Steamphone. Activitatea de pe PC are propriile setări Steam." Style="{StaticResource Caption}" FontSize="11" />
      </VerticalStackLayout>
      <BoxView Style="{StaticResource Divider}" />
      <VerticalStackLayout Spacing="16">
        <Label Text="Pe acest telefon" Style="{StaticResource SectionTitle}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
          <VerticalStackLayout Spacing="5"><Label Text="{Binding MappingCount}" FontFamily="Display" FontSize="28" /><Label Text="aplicații asociate" Style="{StaticResource Caption}" /></VerticalStackLayout>
          <VerticalStackLayout Grid.Column="1" Spacing="5"><Label Text="{Binding TotalTime}" FontFamily="BarlowSemiBold" FontSize="19" /><Label Text="timp înregistrat" Style="{StaticResource Caption}" /></VerticalStackLayout>
        </Grid>
        <Button Text="Asociază o aplicație  +" Command="{Binding AddMappingCommand}" Style="{StaticResource Secondary}" />
        <Button Text="Vezi ce joacă prietenii  →" Command="{Binding OpenFriendsCommand}" Style="{StaticResource Quiet}" />
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
