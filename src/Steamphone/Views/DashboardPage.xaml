<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Steamphone.ViewModels"
             xmlns:core="clr-namespace:Steamphone.Core;assembly=Steamphone.Core"
             x:Class="Steamphone.Views.DashboardPage" x:DataType="vm:DashboardViewModel" Title="Steamphone">
  <ScrollView>
    <VerticalStackLayout Padding="20,12,20,32" Spacing="20" MaximumWidthRequest="680" HorizontalOptions="Fill">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <VerticalStackLayout Spacing="3">
          <Label Text="CONTROLUL TĂU. REGULILE TALE." Style="{StaticResource Eyebrow}" FontSize="10" />
          <Label Text="{Binding AccountName}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
        </VerticalStackLayout>
        <Border Grid.Column="1" Stroke="#4A7193" BackgroundColor="#18344D" StrokeShape="RoundRectangle 12" Padding="12,8" VerticalOptions="Center">
          <Label Text="STEAM&#10;PHONE" FontFamily="monospace" FontSize="12" FontAttributes="Bold" TextColor="#8EDFF4" HorizontalTextAlignment="Center" />
        </Border>
      </Grid>

      <Border Stroke="#3E6284" StrokeShape="RoundRectangle 24" Padding="22">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#164D78" Offset="0" /><GradientStop Color="#172B46" Offset="0.55" /><GradientStop Color="#242C4E" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <VerticalStackLayout Spacing="14">
          <Grid ColumnDefinitions="10,*" ColumnSpacing="8">
            <Ellipse Fill="#A9BBD0" WidthRequest="8" HeightRequest="8" VerticalOptions="Start" Margin="0,5,0,0">
              <Ellipse.Triggers><DataTrigger TargetType="Ellipse" Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="#94E4BD" /></DataTrigger></Ellipse.Triggers>
            </Ellipse>
            <Label Grid.Column="1" Text="{Binding ConnectionMessage}" TextColor="#C9DCED" FontSize="12" />
          </Grid>
          <Label Text="PE TELEFON" TextColor="#8EDFF4" FontSize="10" CharacterSpacing="2" FontAttributes="Bold" />
          <Label Text="{Binding CurrentGame}" TextColor="White" FontFamily="sans-serif-condensed" FontSize="32" FontAttributes="Bold" LineBreakMode="WordWrap" />
          <Label Text="{Binding MonitorMessage}" TextColor="#C9DCED" FontSize="13" />
          <BoxView HeightRequest="1" Color="#47617D" Margin="0,2" />
          <VerticalStackLayout Spacing="5" SemanticProperties.Description="Prezența trimisă de Steamphone">
            <Label Text="CE TRIMITE STEAMPHONE" TextColor="#B7C7E4" FontFamily="monospace" FontSize="10" CharacterSpacing="1" />
            <Label Text="{Binding PresencePreview}" TextColor="#A9E8FA" FontSize="16" FontAttributes="Bold" />
          </VerticalStackLayout>
          <Button Text="Pornește monitorizarea" Command="{Binding StartCommand}" IsVisible="{Binding IsRunning, Converter={StaticResource Not}}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" BackgroundColor="#8EDFF4" TextColor="#102438" />
          <Button Text="Oprește monitorizarea" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" BackgroundColor="#314C69" TextColor="White" />
          <Button Text="Conectează contul Steam" Command="{Binding SignInCommand}" IsVisible="{Binding ShowSignIn}" BackgroundColor="#314C69" TextColor="White" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource Card}" IsVisible="{Binding UsageMissing}" Stroke="#C6A45D">
        <VerticalStackLayout Spacing="8"><Label Text="Permite detectarea jocurilor" Style="{StaticResource SectionTitle}" /><Label Text="Accesul la utilizare este necesar pentru monitorizare. Îl poți activa în Setări." Style="{StaticResource Subtitle}" /><Button Text="Deschide Setări" Command="{Binding OpenSettingsCommand}" Style="{StaticResource Secondary}" /></VerticalStackLayout>
      </Border>
      <Label Style="{StaticResource Error}" />

      <VerticalStackLayout Spacing="5">
        <Label Text="Cum te văd prietenii" Style="{StaticResource SectionTitle}" />
        <Label Text="Alege un mod. Se salvează și se aplică automat." Style="{StaticResource Subtitle}" />
      </VerticalStackLayout>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10"
            RadioButtonGroup.GroupName="Visibility" RadioButtonGroup.SelectedValue="{Binding SelectedVisibility}" IsEnabled="{Binding PrivacySaving, Converter={StaticResource Not}}">
        <Border Style="{StaticResource ModeTile}">
          <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding SelectedVisibility}" Value="{x:Static core:VisibilityMode.Public}"><Setter Property="Stroke" Value="#55B8DD" /><Setter Property="StrokeThickness" Value="2" /></DataTrigger></Border.Triggers>
          <VerticalStackLayout Spacing="0"><RadioButton Content="Joc vizibil" Value="{x:Static core:VisibilityMode.Public}" /><Label Text="Prietenii văd ce joci." Style="{StaticResource Subtitle}" FontSize="12" Margin="14,0,0,0" /></VerticalStackLayout>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource ModeTile}">
          <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding SelectedVisibility}" Value="{x:Static core:VisibilityMode.Invisible}"><Setter Property="Stroke" Value="#A99AE8" /><Setter Property="StrokeThickness" Value="2" /></DataTrigger></Border.Triggers>
          <VerticalStackLayout Spacing="0"><RadioButton Content="Invizibil" Value="{x:Static core:VisibilityMode.Invisible}" /><Label Text="Apari offline. Joc ascuns." Style="{StaticResource Subtitle}" FontSize="12" Margin="14,0,0,0" /></VerticalStackLayout>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ModeTile}">
          <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding SelectedVisibility}" Value="{x:Static core:VisibilityMode.OnlineOnly}"><Setter Property="Stroke" Value="#55B8DD" /><Setter Property="StrokeThickness" Value="2" /></DataTrigger></Border.Triggers>
          <VerticalStackLayout Spacing="0"><RadioButton Content="Doar online" Value="{x:Static core:VisibilityMode.OnlineOnly}" /><Label Text="Apari online. Joc ascuns." Style="{StaticResource Subtitle}" FontSize="12" Margin="14,0,0,0" /></VerticalStackLayout>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ModeTile}">
          <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding SelectedVisibility}" Value="{x:Static core:VisibilityMode.LocalOnly}"><Setter Property="Stroke" Value="#A99AE8" /><Setter Property="StrokeThickness" Value="2" /></DataTrigger></Border.Triggers>
          <VerticalStackLayout Spacing="0"><RadioButton Content="Doar local" Value="{x:Static core:VisibilityMode.LocalOnly}" /><Label Text="Fără conexiune la Steam." Style="{StaticResource Subtitle}" FontSize="12" Margin="14,0,0,0" /></VerticalStackLayout>
        </Border>
      </Grid>
      <VerticalStackLayout Spacing="6">
        <Label Text="{Binding PrivacyDetail}" Style="{StaticResource Subtitle}" />
        <Label Text="Modul controlează doar ce trimite Steamphone. Un joc pornit pe PC sau alt client Steam își poate anunța separat activitatea." Style="{StaticResource Subtitle}" FontSize="11" />
        <ActivityIndicator IsVisible="{Binding PrivacySaving}" IsRunning="{Binding PrivacySaving}" />
      </VerticalStackLayout>

      <Border Style="{StaticResource Card}" IsVisible="{Binding IsPublic}">
        <VerticalStackLayout Spacing="4">
          <Label Text="După închiderea jocului" FontSize="16" FontAttributes="Bold" />
          <Picker Title="Status Steam în afara jocului" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" SemanticProperties.Description="Status Steam după închiderea jocului" />
        </VerticalStackLayout>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="5"><Label Text="{Binding MappingCount}" FontFamily="monospace" FontSize="28" FontAttributes="Bold" /><Label Text="aplicații mapate" Style="{StaticResource Subtitle}" FontSize="12" /></VerticalStackLayout></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout Spacing="5"><Label Text="{Binding TotalTime}" FontFamily="sans-serif-condensed" FontSize="22" FontAttributes="Bold" /><Label Text="timp salvat local" Style="{StaticResource Subtitle}" FontSize="12" /></VerticalStackLayout></Border>
      </Grid>
      <Button Text="+ Asociază o aplicație cu un joc" Command="{Binding AddMappingCommand}" Style="{StaticResource Secondary}" />
      <Button Text="Deschide hub-ul de prieteni →" Command="{Binding OpenFriendsCommand}" Style="{StaticResource Secondary}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
