<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Steamphone.ViewModels"
             x:Class="Steamphone.Views.SettingsPage" x:DataType="vm:SettingsViewModel" Title="Setări">
  <ScrollView>
    <VerticalStackLayout Padding="24,20,24,32" Spacing="26" MaximumWidthRequest="720" HorizontalOptions="Fill">
      <VerticalStackLayout Spacing="5">
        <Label Text="STEAMPHONE" Style="{StaticResource Eyebrow}" />
        <Label Text="Setări" Style="{StaticResource Title}" />
        <Label Text="Aspect, conexiune și datele tale." Style="{StaticResource Subtitle}" />
      </VerticalStackLayout>
      <VerticalStackLayout Spacing="14">
        <Label Text="Aspect și monitorizare" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="18">
          <VerticalStackLayout Spacing="18">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <VerticalStackLayout Spacing="6"><Label Text="Temă" Style="{StaticResource Caption}" /><Border Style="{StaticResource Input}" Padding="8,0"><Picker Title="Temă" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" /></Border></VerticalStackLayout>
              <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="Detecție (secunde)" Style="{StaticResource Caption}" /><Border Style="{StaticResource Input}" Padding="8,0"><Picker Title="Interval" ItemsSource="{Binding Intervals}" SelectedItem="{Binding PollSeconds}" /></Border></VerticalStackLayout>
            </Grid>
            <Label Text="2 secunde: reacție rapidă. 5–10 secunde: mai puține verificări." Style="{StaticResource Caption}" />
            <Label Text="Prietenii se încarcă doar cât timp ai fila deschisă. Pentru zero trafic Steam, alege Doar local din Acasă." Style="{StaticResource Caption}" />
            <BoxView Style="{StaticResource Divider}" />
            <VerticalStackLayout Spacing="5">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="Conexiune cu ecranul blocat" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding KeepConnectionWhenLocked}" SemanticProperties.Description="Menține conexiunea Steam cu ecranul blocat" />
              </Grid>
              <Label Text="Oprit implicit, pentru baterie. Pornit, menține procesorul activ și consumă mai mult. Timpul de joc se oprește la blocarea ecranului." Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <BoxView Style="{StaticResource Divider}" />
            <VerticalStackLayout Spacing="5">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="Anunță jocul când sunt invizibil" FontFamily="BarlowSemiBold" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding AnnounceGameWhileInvisible}" SemanticProperties.Description="Trimite jocul către Steam cu status Invizibil" />
              </Grid>
              <Label Text="Opțional. Trimite jocul către Steam cu status Invizibil și poate permite înregistrarea orelor. Confidențialitatea profilului se configurează separat în Steam." Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <Button Text="Salvează preferințele" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            <Label Text="{Binding SavedMessage}" Style="{StaticResource Caption}" TextColor="{AppThemeBinding Light=#3C765B, Dark=#79D4B3}" />
          </VerticalStackLayout>
        </Border>
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="14">
        <Label Text="Permisiuni Android" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="18">
          <VerticalStackLayout Spacing="14">
            <VerticalStackLayout Spacing="5">
              <Label Text="Acces la utilizare" FontFamily="BarlowSemiBold" FontSize="16" />
              <Label Text="{Binding UsageLabel}" Style="{StaticResource Caption}" />
              <Button Text="Deschide accesul la utilizare  ↗" Command="{Binding UsageCommand}" Style="{StaticResource Secondary}" FontSize="13" />
            </VerticalStackLayout>
            <BoxView Style="{StaticResource Divider}" />
            <VerticalStackLayout Spacing="5">
              <Label Text="Baterie" FontFamily="BarlowSemiBold" FontSize="16" />
              <Label Text="{Binding BatteryLabel}" Style="{StaticResource Caption}" />
              <Button Text="Deschide optimizarea bateriei  ↗" Command="{Binding BatteryCommand}" Style="{StaticResource Secondary}" FontSize="13" />
              <Label Text="Alege Steamphone în lista Android. Unele telefoane au și o setare de pornire automată." Style="{StaticResource Caption}" FontSize="11" />
            </VerticalStackLayout>
            <BoxView Style="{StaticResource Divider}" />
            <VerticalStackLayout Spacing="5">
              <Label Text="Notificarea de monitorizare" FontFamily="BarlowSemiBold" FontSize="16" />
              <Label Text="{Binding NotificationLabel}" Style="{StaticResource Caption}" />
              <Button Text="Deschide setările notificărilor  ↗" Command="{Binding NotificationsCommand}" Style="{StaticResource Secondary}" FontSize="13" />
            </VerticalStackLayout>
          </VerticalStackLayout>
        </Border>
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="14">
        <Label Text="Backup și transfer" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="18">
          <VerticalStackLayout Spacing="14">
            <Label Text="Ia cu tine aplicațiile asociate, preferințele și istoricul de joc." FontFamily="BarlowMedium" />
            <Label Text="Fișier JSON. Parolele și sesiunea Steam rămân pe telefon." Style="{StaticResource Caption}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Text="Exportă  ↗" Command="{Binding ExportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
              <Button Grid.Column="1" Text="Importă  ↙" Command="{Binding ImportCommand}" Style="{StaticResource Secondary}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            </Grid>
            <Label Text="La export, alege unde salvezi fișierul din selectorul Android." Style="{StaticResource Caption}" FontSize="11" />
            <Label Text="{Binding BackupMessage}" Style="{StaticResource Subtitle}" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
          </VerticalStackLayout>
        </Border>
      </VerticalStackLayout>
      <Label Style="{StaticResource Error}" />
      <BoxView Style="{StaticResource Divider}" />
      <VerticalStackLayout Spacing="14">
        <Label Text="Cont Steam" Style="{StaticResource SectionTitle}" />
        <Label Text="Deconectarea elimină sesiunea salvată. Asocierile și istoricul rămân pe telefon." Style="{StaticResource Caption}" />
        <Button Text="Deconectează contul" Command="{Binding LogoutCommand}" Style="{StaticResource Secondary}" TextColor="{AppThemeBinding Light=#AD3044, Dark=#F3A1AA}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
      </VerticalStackLayout>
      <Label Text="STEAMPHONE / ANDROID" Style="{StaticResource Eyebrow}" FontSize="10" HorizontalOptions="Center" Margin="0,12,0,0" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
