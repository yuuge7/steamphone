<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Steamphone.ViewModels"
             x:Class="Steamphone.Views.SettingsPage" x:DataType="vm:SettingsViewModel" Title="Setări">
  <ScrollView>
    <VerticalStackLayout Padding="20,20,20,32" Spacing="18" MaximumWidthRequest="620" HorizontalOptions="Fill">
      <Label Text="Pregătit pentru fundal" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="Android are nevoie de acordul tău pentru a recunoaște aplicațiile și a păstra serviciul activ." Style="{StaticResource Subtitle}" />
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="12">
          <Label Text="Backup și transfer" FontSize="20" FontAttributes="Bold" />
          <Label Text="Salvează mapările, preferințele și istoricul într-un fișier JSON. Parolele și tokenurile Steam rămân pe telefon." Style="{StaticResource Subtitle}" />
          <Button Text="Exportă un fișier" Command="{Binding ExportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
          <Label Text="Downloads este locația inițială. Poți alege alt dosar sau furnizor de fișiere în selectorul Android." Style="{StaticResource Subtitle}" FontSize="12" />
          <Button Text="Importă un fișier" Command="{Binding ImportCommand}" Style="{StaticResource Secondary}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
          <Label Text="{Binding BackupMessage}" Style="{StaticResource Subtitle}" />
          <Label Style="{StaticResource Error}" />
          <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
        </VerticalStackLayout>
      </Border>
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="12">
          <Label Text="Acces la utilizare" FontSize="19" FontAttributes="Bold" /><Label Text="{Binding UsageLabel}" Style="{StaticResource Subtitle}" />
          <Button Text="Deschide accesul la utilizare" Command="{Binding UsageCommand}" Style="{StaticResource Secondary}" />
          <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DFE8F0, Dark=#2D435A}" Margin="0,4" />
          <Label Text="Baterie" FontSize="19" FontAttributes="Bold" /><Label Text="{Binding BatteryLabel}" Style="{StaticResource Subtitle}" />
          <Button Text="Deschide optimizarea bateriei" Command="{Binding BatteryCommand}" Style="{StaticResource Secondary}" />
          <Label Text="În lista Android, alege Steamphone și permite rularea fără restricții. Unele telefoane au și o setare separată de pornire automată." Style="{StaticResource Subtitle}" FontSize="12" />
          <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DFE8F0, Dark=#2D435A}" Margin="0,4" />
          <Label Text="Notificare persistentă" FontSize="19" FontAttributes="Bold" /><Label Text="{Binding NotificationLabel}" Style="{StaticResource Subtitle}" />
          <Button Text="Deschide setările notificărilor" Command="{Binding NotificationsCommand}" Style="{StaticResource Secondary}" />
        </VerticalStackLayout>
      </Border>
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
          <Label Text="Preferințe" FontSize="20" FontAttributes="Bold" />
          <Label Text="Temă" Style="{StaticResource Subtitle}" /><Picker Title="Temă" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
          <Label Text="Verifică aplicația la fiecare (secunde)" Style="{StaticResource Subtitle}" /><Picker Title="Interval" ItemsSource="{Binding Intervals}" SelectedItem="{Binding PollSeconds}" />
          <Button Text="Salvează preferințele" Command="{Binding SaveCommand}" />
          <Label Text="{Binding SavedMessage}" Style="{StaticResource Subtitle}" />
        </VerticalStackLayout>
      </Border>
      <Label Style="{StaticResource Error}" />
      <Label Text="La blocarea ecranului, cronometrarea se oprește. Serviciul păstrează conexiunea cât permite sistemul și se reconectează automat după întreruperi. Un AppID schimbă jocul anunțat; Valve decide dacă îl afișează și dacă înregistrează ore în cont." Style="{StaticResource Subtitle}" FontSize="12" />
      <Button Text="Deconectează și șterge sesiunea" Command="{Binding LogoutCommand}" Style="{StaticResource Secondary}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
